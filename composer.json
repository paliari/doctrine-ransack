{
    "authors": [
        {
            "name": "Marcos Paliari",
            "email": "marcos@paliari.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Paliari\\Doctrine\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "": "tests/models"
        }
    },
    "description": "Advanced query searching for Doctrine ORM (based on Ruby on Rails Ransack)",
    "homepage": "https://github.com/paliari/doctrine-ransack",
    "license": "MIT",
    "name": "paliari/doctrine-ransack",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/paliari/doctrine-ransack.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.7",
        "doctrine/dbal": "^4.3",
        "paliari/php-utils": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "fakerphp/faker": "^1.24",
        "doctrine/deprecations": "^1.1"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "type": "library",
    "version": "2.3.0"
}
