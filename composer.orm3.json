{
    "name": "paliari/doctrine-ransack",
    "description": "Test setup for doctrine-ransack with doctrine/orm 3.x (run with COMPOSER=composer.orm3.json)",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Paliari\\Doctrine\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "": "tests/models"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.3",
        "paliari/php-utils": "^2.0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "fakerphp/faker": "^1.24",
        "doctrine/deprecations": "^1.1"
    },
    "config": {
        "vendor-dir": "vendor-orm3",
        "platform": {
            "php": "8.2.0"
        }
    }
}
